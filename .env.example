# ==============================================
# DniproAnimals Environment Variables Template
# ==============================================

# Environment mode: development | production | test
NODE_ENV=development

# ----------------------------------------------
# Database (PostgreSQL / Drizzle)
# ----------------------------------------------
# Direct connection string (optional - if omitted, constructed from DB_* parameters)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dniproanimals
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=dniproanimals

# ----------------------------------------------
# Redis (Sessions, Caching)
# ----------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379

# ----------------------------------------------
# Session Security
# ----------------------------------------------
SESSION_SECRET=dev-secret-change-me-please-min-10-chars

# ----------------------------------------------
# Server / API Configuration
# ----------------------------------------------
SERVER_PORT=3001
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# ----------------------------------------------
# Mail / SMTP (Mailpit in Docker)
# ----------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@dniproanimals.local

# ----------------------------------------------
# Supabase (Storage / Public API)
# ----------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://bmxcvlhiiushaegvkunx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your-supabase-publishable-key

# ----------------------------------------------
# Google OAuth
# ----------------------------------------------
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ----------------------------------------------
# PDF Generation (Puppeteer) - Optional
# ----------------------------------------------
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome-stable
